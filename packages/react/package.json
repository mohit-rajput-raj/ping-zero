{
  "name": "@ping-zero/react",
  "version": "0.1.0",
  "description": "React components and hooks for ping-zero realtime messaging — powered by shadcn/ui",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && npm run build:styles",
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "dev": "tsc --watch",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "check-types": "tsc --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@ping-zero/client": "workspace:*",
    "@ping-zero/prisma": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ping-zero",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/your-username/ping-zero#readme",
  "keywords": ["react", "chat", "ui", "components", "shadcn", "ping-zero", "realtime"]
}
